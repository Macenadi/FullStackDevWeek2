@page "/createproduct"

@using FullStackDevWeek2.Models;
@using FullStackDevWeek2.Services;

@inject ProductService ProductService

@rendermode InteractiveServer

<h3>CreateProduct</h3>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-success mt-3">
        @Message
    </div>
}
    <EditForm Model="@product" OnValidSubmit="SaveProduct">
        <DataAnnotationsValidator />
        <ValidationSummary />


       // Each div below represents a form field for the product properties, with labels and input controls bound to the product model.

        <div class="mt-3">
        <label class="form-label">Product Name</label>
        </div>


        <div class="mt-3">
        <label class="form-label">Description</label>
        <InputText class="form-control" @bind-Value="product.Description" />
        </div>


        <div class="mt-3">
        <label class="form-label">Price</label>
        <InputNumber class="form-control" @bind-Value="product.Price" />
        </div>


        <div class="mt-3">
        <label class="form-label">Quantity in Stock</label>
        <InputNumber class="form-control" @bind-Value="product.QuantityInStock" />
        </div>

        <div class="mt-3">
        <label class="form-label">Category</label>

        <InputSelect class="form-control" @bind-Value="product.Category">

        <option value="">Select Category</option>
        <option>Electronics</option>
        <option>Books</option>
        <option>Clothing</option>
        <option>Sports</option>
        <option>Home & Garden</option>

        </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Save</button>
        </EditForm>

        @code {
        private Product product = new();

        private string Message = "";

        private async Task SaveProduct()
        {
            var productReturn = await ProductService.AddProductAsync(product);

            if (productReturn != null)
            {
                Message = "Product created successfully!";

                product = new Product(); // Reset the form
            }
            else
            {
                Message = "Failed to create product.";
            }

        }

}
